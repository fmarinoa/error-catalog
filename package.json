{
  "name": "@fmarinoa/error-catalog",
  "version": "0.1.0",
  "description": "Typed HTTP error catalog: error classes, JSON body, JSON Schema, one-line log and an Express error handler",
  "license": "MIT",
  "author": "Franco Marino Aquise",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmarinoa/error-catalog.git"
  },
  "homepage": "https://github.com/fmarinoa/error-catalog#readme",
  "bugs": {
    "url": "https://github.com/fmarinoa/error-catalog/issues"
  },
  "keywords": [
    "errors",
    "http",
    "typescript",
    "express",
    "json-schema",
    "standard-schema"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./express": "./src/adapters/express.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./express": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "express": "5.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
